# ==============================================================================
# SWASTHYACALL BACKEND ENVIRONMENT CONFIGURATION (RENDER / PRODUCTION)
# ==============================================================================

# Project & Runtime Environment
PROJECT_NAME="SwasthyaCall API"
ENVIRONMENT=production
SERVER_HOST=0.0.0.0
# Note: Render automatically assigns and binds to PORT (e.g. 10000)
PORT=8000

# ------------------------------------------------------------------------------
# MongoDB Database (Local or MongoDB Atlas)
# For Atlas, use: mongodb+srv://<username>:<password>@<cluster-url>/swasthyacall?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/swasthyacall?retryWrites=true&w=majority
DATABASE_NAME=swasthyacall

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# Generate a strong 64-character secret (e.g. using `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_secure_random_64_character_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# AI Engine — Hosted Gemma 4 / OpenRouter
# ------------------------------------------------------------------------------
GEMMA_API_BASE=https://openrouter.ai/api/v1
GEMMA_MODEL_NAME=google/gemma-2-9b-it
GEMMA_MODE=online
GEMMA_API_KEY=sk-or-v1-your-openrouter-api-key-here

# ------------------------------------------------------------------------------
# Telephony — Twilio Voice & TwiML Webhooks
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_DEMO_MODE=false
TWILIO_VERIFY_SIGNATURE=false

# ------------------------------------------------------------------------------
# Public Webhook Base URL (Crucial for Twilio Webhooks behind Render / Reverse Proxy)
# Set this to your deployed Render URL: https://<your-service-name>.onrender.com
# ------------------------------------------------------------------------------
PUBLIC_WEBHOOK_URL=https://your-service-name.onrender.com

# ------------------------------------------------------------------------------
# CORS & Web Client Access
# Comma-separated list of permitted frontend origins
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=https://swasthyacall.vercel.app
ALLOWED_ORIGINS=https://swasthyacall.vercel.app,https://your-custom-domain.com

# ------------------------------------------------------------------------------
# Telephony & Healthcare Settings
# ------------------------------------------------------------------------------
SMS_NOTIFICATIONS_ENABLED=true
EMERGENCY_NUMBER=112
